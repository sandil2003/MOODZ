FROM node:20-alpine

WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
RUN npm install

# Copy the rest of the application
COPY . .

# Expose the default Angular port
EXPOSE 4200

# Start the development server with polling to ensure hot-reload works in Docker
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--poll", "2000"]
