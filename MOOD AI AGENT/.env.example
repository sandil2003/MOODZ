

# Application Settings
APP_NAME=MOODZ AI Agent
API_VERSION=1.0.0
DEBUG=false

# Database (Use Hugging Face Spaces PostgreSQL or external DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Use external Redis service)
REDIS_URL=redis://host:6379/0

# OpenAI API
OPENAI_API_KEY=sk-your-key-here

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX_NAME=moodz-index

# Google Gemini (Optional)
GOOGLE_API_KEY=your-google-key

# CORS Origins (Add your frontend URL)
CORS_ORIGINS=["https://your-frontend.hf.space","http://localhost:4200"]

# Session Settings
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_USER=10

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
